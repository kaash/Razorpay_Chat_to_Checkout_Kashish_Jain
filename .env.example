# Copy to .env for local runs, and add the same names in Vercel → Project → Settings → Environment Variables.
# Never commit .env. Never put these in index.html.

# Claude API (https://console.anthropic.com). Set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional. Check the current model IDs at https://docs.claude.com/en/docs/about-claude/models/overview
CLAUDE_MODEL=claude-sonnet-5-5

# Razorpay TEST keys only (Dashboard → switch to Test Mode → Account & Settings → API Keys). They start with rzp_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Abuse limits (per IP, best effort)
RATE_PER_MIN=8
RATE_PER_DAY=120
LINKS_PER_MIN=6
LINKS_PER_DAY=60
MAX_LINK_PAISE=5000000

# Local testing without keys
# MOCK_AI=1
# MOCK_PAY=1
